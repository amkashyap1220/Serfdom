{
  "compilerOptions": {
    "target": "ES2022",
    // No DOM: shared code must also run on the Node server, so browser APIs
    // like `window` or `document` are a type error here.
    "lib": ["ES2022"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Explicit .ts import paths let Node run these files directly later.
    "allowImportingTsExtensions": true,
    // Only syntax Node can strip without compiling (no enums, namespaces,
    // or constructor parameter properties), because the server runs this
    // code directly with Node type stripping.
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
