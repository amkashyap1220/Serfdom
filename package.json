{
  "name": "serfdom",
  "private": true,
  "description": "Browser-first multiplayer top-down action RPG.",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green --kill-others-on-fail \"npm run dev -w @serfdom/server\" \"npm run dev -w @serfdom/client\"",
    "build": "npm run build -w @serfdom/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dev:server": "npm run dev -w @serfdom/server",
    "dev:client": "npm run dev -w @serfdom/client"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ]
}
