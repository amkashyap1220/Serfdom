{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    // Matches how Node itself resolves ES modules.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Node runs these .ts files directly by stripping types, so imports use
    // real .ts paths and only strippable syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
