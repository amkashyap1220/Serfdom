# Copy to .env (git-ignored) and fill in real values. Since Phase 7 the
# database URLs are required.
# Placeholders only: never put real secrets in this file.

# Game server address the browser client connects to.
VITE_SERVER_URL=ws://localhost:8080

# Port the game server listens on (used by `npm run dev` / server).
PORT=8080

# PostgreSQL (Phase 7, D-059). Put the real password only in .env, never here.
DATABASE_URL=postgres://serfdom:CHANGE_ME@localhost:5432/serfdom
# A separate database the tests may wipe and rebuild.
TEST_DATABASE_URL=postgres://serfdom:CHANGE_ME@localhost:5432/serfdom_test
